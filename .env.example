
# PostgreSQL is verplicht. Gebruik lokaal een aparte gratis Neon development-branch.
NEON_POSTGRES_PRISMA_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
NEON_POSTGRES_URL_NON_POOLING=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
AUTH_SECRET=vervang-door-minimaal-32-willekeurige-tekens
CRON_SECRET=vervang-door-een-ander-geheim-van-minimaal-32-tekens
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_PASSWORD=
LEAD_GENERATION_TARGET=10
LEAD_CANDIDATE_BUFFER=200
OSM_SOURCE_ENABLED=true
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_API_URLS=https://overpass-api.de/api/interpreter,https://lz4.overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter
OVERPASS_TIMEOUT_MS=9000
OVERPASS_TOTAL_TIMEOUT_MS=18000
OVERPASS_MAX_RESPONSE_BYTES=2000000
GENERATION_BATCH_DURATION_SECONDS=45
GENERATION_MAX_SOURCE_CALLS=40
GENERATION_MAX_SOURCE_FAILURES=12
GENERATION_MAX_RUN_MINUTES=10
QUALIFIED_DRAFT_MAX_AGE_HOURS=24
GENERATION_BATCH_CANDIDATES=8
GENERATION_BATCH_WEBSITE_CHECKS=3
GENERATION_WATCHDOG_SECONDS=60
WEBSITE_CHECK_CONCURRENCY=3
WEBSITE_FETCH_MAX_BYTES=1000000
WEBSITE_CANDIDATE_DNS_CHECK=true
SESSION_TTL_DAYS=14
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Cold e-mail: wachtwoorden uitsluitend als beveiligde deploymentvariabelen instellen.
COLD_EMAIL_FROM_ADDRESS=info@sitora.nl
COLD_EMAIL_FROM_NAME=Sitora
COLD_EMAIL_WARMUP_START=2026-08-04
COLD_EMAIL_TIME_ZONE=Europe/Amsterdam
MAIL_SMTP_HOST=mail.sitora.nl
MAIL_SMTP_PORT=587
MAIL_SMTP_SECURE=false
MAIL_IMAP_HOST=mail.sitora.nl
MAIL_IMAP_PORT=993
MAIL_IMAP_SECURE=true
MAIL_USERNAME=info@sitora.nl
MAIL_PASSWORD=
MAIL_SENT_FOLDER=
