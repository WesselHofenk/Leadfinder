{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm vercel-build",
  "installCommand": "pnpm install --frozen-lockfile",
  "functions": {
    "app/api/generation/route.ts": { "maxDuration": 60 },
    "app/api/cron/generation/route.ts": { "maxDuration": 60 },
    "app/api/cron/outreach/route.ts": { "maxDuration": 300 },
    "app/api/cron/reverify/route.ts": { "maxDuration": 300 },
    "app/api/cron/analyze/route.ts": { "maxDuration": 300 }
  }
}
